# Runtime backend: transformers, vllm, or python.module:factory.
KVCACHE_BACKEND=transformers

# Model identity. Keep revision/fingerprint immutable across a cache namespace.
KVCACHE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
KVCACHE_MODEL_REVISION=main
KVCACHE_MODEL_FINGERPRINT=

# Local Transformers reference backend.
KVCACHE_DEVICE=auto
KVCACHE_DTYPE=auto
KVCACHE_TRUST_REMOTE_CODE=false
KVCACHE_LOCAL_FILES_ONLY=false
KVCACHE_MAX_CONTEXT_TOKENS=0
KVCACHE_DEFAULT_CHUNK_SIZE=512
KVCACHE_MAX_NEW_TOKENS=2048

# Physical tensor store (Transformers) or logical SQLite index (vLLM).
KVCACHE_STORE_DIR=./data/kv-cache
KVCACHE_VERIFY_CHECKSUM=true
KVCACHE_CACHE_TTL_SECONDS=0
KVCACHE_MAX_STORE_BYTES=0

# Authentication and tenant isolation.
# Development/single-tenant key:
KVCACHE_API_KEY=
# Production mapping, for example: {"tenant-a":"key-a","tenant-b":"key-b"}
KVCACHE_API_KEYS=
KVCACHE_ADMIN_API_KEY=
KVCACHE_TENANT_HEADER=X-Tenant-ID

# Admission control and deadlines. A token rate of 0 disables token throttling.
KVCACHE_REQUEST_TIMEOUT_SECONDS=600
KVCACHE_ADMISSION_QUEUE_TIMEOUT_SECONDS=5
KVCACHE_SHUTDOWN_GRACE_SECONDS=30
KVCACHE_MAX_CONCURRENT_REQUESTS=256
KVCACHE_MAX_CONCURRENT_PER_TENANT=32
KVCACHE_RATE_LIMIT_TOKENS_PER_MINUTE=0
KVCACHE_RATE_LIMIT_BURST_TOKENS=0

# vLLM production data plane. Comma-separated endpoints are routed independently.
KVCACHE_VLLM_ENDPOINTS=http://127.0.0.1:8000
KVCACHE_VLLM_API_KEY=
KVCACHE_VLLM_TIMEOUT_SECONDS=600
KVCACHE_VLLM_MAX_RETRIES=1
KVCACHE_VLLM_CIRCUIT_BREAKER_FAILURES=3
KVCACHE_VLLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=15
KVCACHE_VLLM_AFFINITY_WEIGHT=10

# Optional LMCache MP HTTP frontend; /healthcheck is included in readiness.
KVCACHE_LMCACHE_CONTROLLER_URL=

# Shared logical cache index for multiple gateway replicas. Omit for local SQLite.
KVCACHE_REDIS_URL=
KVCACHE_REDIS_KEY_PREFIX=kvcache

# HTTP and observability.
KVCACHE_HOST=0.0.0.0
KVCACHE_PORT=8080
KVCACHE_LOG_LEVEL=info
KVCACHE_METRICS_ENABLED=true
