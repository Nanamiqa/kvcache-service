# Runtime backend. Use "transformers" or "python.module:factory".
KVCACHE_BACKEND=transformers

# Local/private model configuration.
KVCACHE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
KVCACHE_MODEL_REVISION=main
KVCACHE_DEVICE=auto
KVCACHE_DTYPE=auto
KVCACHE_TRUST_REMOTE_CODE=false
KVCACHE_LOCAL_FILES_ONLY=false

# Persistent KV files. Do not put secrets in this directory.
KVCACHE_STORE_DIR=./data/kv-cache
KVCACHE_VERIFY_CHECKSUM=true

# 0 means: read max_position_embeddings from the model config.
KVCACHE_MAX_CONTEXT_TOKENS=0
KVCACHE_DEFAULT_CHUNK_SIZE=512
KVCACHE_MAX_NEW_TOKENS=2048

# REST server.
KVCACHE_HOST=0.0.0.0
KVCACHE_PORT=8080
KVCACHE_LOG_LEVEL=info
