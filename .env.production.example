# Copy to .env.production and pin images to immutable versions or digests.
LMCACHE_SERVER_IMAGE=lmcache/standalone:REPLACE_WITH_PINNED_VERSION
LMCACHE_VLLM_IMAGE=lmcache/vllm-openai:REPLACE_WITH_PINNED_VERSION
REDIS_IMAGE=redis:REPLACE_WITH_PINNED_VERSION
REDIS_PASSWORD=replace-with-a-long-random-password
VLLM_API_KEY=replace-with-a-separate-internal-api-key

KVCACHE_MODEL=Qwen/Qwen3-8B
KVCACHE_MODEL_REVISION=REPLACE_WITH_IMMUTABLE_REVISION
KVCACHE_MODEL_FINGERPRINT=REPLACE_WITH_RELEASE_OR_WEIGHT_HASH

# Compose receives this as a single JSON value.
KVCACHE_API_KEYS={"tenant-a":"replace-me-a","tenant-b":"replace-me-b"}
KVCACHE_ADMIN_API_KEY=replace-me-admin

KVCACHE_MAX_CONCURRENT_REQUESTS=512
KVCACHE_MAX_CONCURRENT_PER_TENANT=32
KVCACHE_RATE_LIMIT_TOKENS_PER_MINUTE=0
KVCACHE_RATE_LIMIT_BURST_TOKENS=0

LMCACHE_L1_SIZE_GB=100
LMCACHE_MAX_WORKERS=4
LMCACHE_MAX_GPU_WORKERS=2
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_BATCHED_TOKENS=8192
VLLM_GPU_MEMORY_UTILIZATION=0.9
